{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "newbee",
  "version": "0.1.1",
  "identifier": "com.windytiany.newbee",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "newbee",
        "width": 800,
        "height": 600,
        "minWidth": 768,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "本地音乐库管理与播放",
    "longDescription": "NewBee 是一款面向本地音乐收藏的桌面播放器，可扫描和管理音乐目录，按艺人和专辑浏览曲目，创建播放列表，并通过播放队列控制播放。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
